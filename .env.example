# Copy to .env and fill in. .env is git-ignored and read at startup (job_agent/config.py).
# Gmail: a 16-character app password (Google account -> Security -> 2-Step Verification -> App passwords).
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=
# Only when config.yaml llm.provider is gemini (or you pass --provider gemini). Google AI Studio -> Get API key.
GEMINI_API_KEY=
